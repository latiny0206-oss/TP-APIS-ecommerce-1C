  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST Register cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{cliente_username}}\",\n  \"email\": \"{{cliente_username}}@mail.com\",\n  \"password\": \"{{cliente_password}}\",\n  \"nombre\": \"Cliente\",\n  \"apellido\": \"Uno\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('cliente_username', 'cliente_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Estructura auth', () => { pm.expect(json.token).to.be.a('string').and.not.empty; pm.expect(json.username).to.eql(pm.collectionVariables.get('cliente_username')); pm.expect(json.rol).to.eql('CLIENTE'); });",
                  "pm.collectionVariables.set('cliente_token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Register cliente2",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{cliente2_username}}\",\n  \"email\": \"{{cliente2_username}}@mail.com\",\n  \"password\": \"{{cliente2_password}}\",\n  \"nombre\": \"Cliente\",\n  \"apellido\": \"Dos\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.collectionVariables.set('cliente2_username', 'cliente2_' + Date.now());"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Token cliente2', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('cliente2_token', json.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" }
          },
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Token admin', () => pm.expect(json.token).to.be.a('string').and.not.empty);",
              "pm.collectionVariables.set('admin_token', json.token);"
            ] }
          }]
        },
        {
          "name": "POST Login cliente",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{cliente_username}}\",\n  \"password\": \"{{cliente_password}}\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('cliente_token', json.token);"
          ] } }]
        },
        {
          "name": "POST Login invalido (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"no_existe\",\n  \"password\": \"NoExiste123\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 401', () => pm.response.to.have.status(401));",
            "const json = pm.response.json();",
            "pm.test('Error auth', () => { pm.expect(json.status).to.eql(401); pm.expect(json.error).to.eql('Unauthorized'); });"
          ] } }]
        },
        {
          "name": "POST Register password debil (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/api/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"weak_{{timestamp}}\",\n  \"email\": \"weak_{{timestamp}}@mail.com\",\n  \"password\": \"abc\",\n  \"nombre\": \"Weak\",\n  \"apellido\": \"User\"\n}" }
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.collectionVariables.set('timestamp', Date.now());"] } },
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "const json = pm.response.json();",
              "pm.test('Validation error', () => { pm.expect(json.status).to.eql(400); pm.expect(json.error).to.include('Validation'); });"
            ] } }
          ]
        }
      ]
    },
