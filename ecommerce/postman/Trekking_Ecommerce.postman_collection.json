    "description": "Coleccion QA para ejecutar flujos completos de la API de e-commerce trekking."
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "admin_token", "value": "" },
    { "key": "cliente_token", "value": "" },
    { "key": "cliente2_token", "value": "" },
    { "key": "cliente_username", "value": "" },
    { "key": "cliente2_username", "value": "" },
    { "key": "cliente_password", "value": "ClientePass1" },
    { "key": "cliente2_password", "value": "ClientePass1" },
    { "key": "cliente_user_id", "value": "" },
    { "key": "cliente2_user_id", "value": "" },
    { "key": "categoria_id", "value": "" },
    { "key": "marca_id", "value": "" },
    { "key": "producto_id", "value": "" },
    { "key": "variante_id", "value": "" },
    { "key": "descuento_id", "value": "" },
    { "key": "carrito_id", "value": "" },
    { "key": "item_carrito_id", "value": "" },
    { "key": "orden_id", "value": "" },
