          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Nombre actualizado', () => pm.expect(pm.response.json().nombre).to.eql('Categoria QA actualizada'));"
          ] } }]
        },
